@model SSD_LAB1.Models.CompanyContract

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Company Contract</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ContractNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ContractNumber)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StartDate)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EndDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EndDate)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ContractValue)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ContractValue)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>

        <dt class="col-sm-2">
            Company
        </dt>
        <dd class="col-sm-10">
            @Model.Company?.Name
        </dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Supervisor"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <span> | </span>
    }

    <a asp-action="Index">Back to List</a>
</div>